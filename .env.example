# HuggingFace API Token (Required for downloading HeAR foundation model weights)
# Obtain token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# Optional path overrides (defaults to repository data/ and models/ directories)
# PULMOVEC_DATA_DIR=/path/to/data
# PULMOVEC_MODEL_DIR=/path/to/models
# PULMOVEC_WAV_DIR=/path/to/data/wavfiles
